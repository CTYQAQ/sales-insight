# ===== 基础 =====
APP_NAME=Sales Insight
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
# 生产环境务必改成实际前端域名，禁止用 *
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ===== 数据库 =====
# 本机默认 SQLite；切 PostgreSQL 示例：postgresql+psycopg://user:pass@localhost:5432/sales
DATABASE_URL=sqlite:///./sales_insight.db
SQL_ECHO=false

# ===== 认证 =====
# 至少 16 位随机串，生产必须更换（生成方式：openssl rand -hex 32）
JWT_SECRET=dev-only-change-me-please-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=7

# ===== AI 引擎 =====
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 本地 Ollama（把 LLM_PROVIDER 改成 ollama 即可切换）
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=deepseek-r1:7b
LLM_TIMEOUT_SEC=120
LLM_MAX_RETRIES=2

# ===== 对话问数 =====
TEXT2SQL_ENABLED=true
TEXT2SQL_TABLES=["fact_sales","dim_customer","dim_product","dim_region"]
TEXT2SQL_ROW_LIMIT=500

# ===== RAG 知识库 =====
# 变量名必须是 MILVUS_CONN，不能叫 MILVUS_URI：
# pymilvus 在 import 阶段会读 MILVUS_URI 初始化模块级单例并校验格式（只认 http(s)://），
# lite 的文件路径会被判非法，直接抛 ConnectionConfigException。
#
# lite（免 Docker，单进程）：./milvus.db    standalone（需 Docker）：http://127.0.0.1:19530
#
# ⚠ Windows + lite 的硬限制：库文件路径**不能含中文**（含父目录）。
#   底层 faiss 用窄字符写索引文件，中文路径下会失败，而且表现极具欺骗性：
#   upsert 成功、count 正确，只有真正检索时才空 —— 或抛出
#   "faiss::FileIOWriter ... could not open xxx.idx"。
#   项目放在中文目录下时，把这一项指向一个纯英文目录即可（数据与代码分离）：
#     MILVUS_CONN=C:/Users/<you>/milvus-data/sales-insight.db
#   代码里 _check_ascii_path() 会在连接阶段就拦下并给出可执行建议。
MILVUS_CONN=./milvus.db
MILVUS_COLLECTION=sales_knowledge
# local（默认，零依赖哈希）| bge（本地 sentence-transformers）| api（OpenAI 兼容 /embeddings）
EMBEDDING_BACKEND=local
# bge 后端要填完整 HF 仓库名（带 BAAI/ 前缀），api/local 可忽略
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
# bge 模型下载缓存目录
EMBEDDING_MODEL_DIR=./models
# 切换到 api 后端时才需要
EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
EMBEDDING_API_KEY=
# 混合检索开关：false 即退化为纯向量（便于对比排序差异）
RAG_HYBRID=true
RAG_CANDIDATE_K=20
RAG_RRF_K=60
RAG_TOP_K=5
RAG_CHUNK_SIZE=320
RAG_CHUNK_OVERLAP=60
# 额外要扫描的文档目录（md/txt/csv/xlsx），不存在会自动跳过
KB_SOURCE_DIR=./app/kb_docs

# ===== 告警推送 =====
ALERT_DEDUPE_MINUTES=60
WEBHOOK_TYPE=dingtalk
WEBHOOK_URL=
WEBHOOK_KEYWORD=销售分析

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ===== 上传 =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
