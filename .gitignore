# ---- 密钥与环境变量（绝对不能提交）----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# ---- 数据库：含真实业务数据 + 会话令牌 ----
*.db
*.sqlite
*.sqlite3
# SQLite WAL 模式会额外生成 -shm / -wal，两个都不能提交
*.db-shm
*.db-wal

# ---- Milvus lite：以目录形式落盘（collections/ databases/ LOCK）----
milvus*.db/
milvus.db/
# 测试用临时库
backend/milvus_probe.db/
backend/milvus_test.db/

# ---- 模型权重：动辄几百 MB，clone 后自己下 ----
# ⚠ 必须用 / 开头锚定仓库根。写成裸的 `models/` 会匹配任意层级的同名目录，
# 把 backend/app/db/models/（ORM 模型包）一起忽略掉 —— 本地因为有文件看不出问题，
# CI 上直接 ModuleNotFoundError: No module named 'app.db.models'。
/models/
/backend/models/

# ---- 上传目录 ----
uploads/
!uploads/.gitkeep

# ---- 知识库素材目录 ----
# 只保留占位文件。真实语料（含第三方课程笔记/公司文档）不入库：
# 一是体积，二是版权与保密。clone 后用 /api/knowledge/seed 灌内置示例文档，
# 或把自己的文档丢进这个目录再 /api/knowledge/rebuild。
backend/app/kb_docs/*
!backend/app/kb_docs/.gitkeep
!backend/app/kb_docs/_readme.md

# ---- Node ----
node_modules/
frontend/dist/
frontend/.vite/
*.local
# tsc 增量编译缓存
*.tsbuildinfo

# ---- 脚本产物 ----
*_out.txt

# ---- IDE / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
